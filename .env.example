# Do not commit real credentials. This reference implementation needs none.
TARCSMEM_DB_PATH=./data/tarcsmem.db
TARCSMEM_LOG_LEVEL=INFO
# redact (default), reject, audit (development only), or off (external gate only)
TARCSMEM_SECURITY_MODE=redact
# Optional local API bearer token. Use OIDC/SSO and a secret manager in production.
TARCSMEM_API_KEY=
# Per-process pilot safeguard. Enforce distributed limits at the API gateway too.
TARCSMEM_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Persisted write-retry window. A repeated Idempotency-Key replays the first result.
TARCSMEM_IDEMPOTENCY_TTL_HOURS=24

# Answer generation: extractive (zero-credential demo), ollama, or deepseek.
TARCSMEM_LLM_PROVIDER=extractive

# Local Ollama (no API key required)
TARCSMEM_OLLAMA_URL=http://127.0.0.1:11434
TARCSMEM_OLLAMA_MODEL=qwen3:4b

# DeepSeek cloud. Never commit a real key; put it only in an untracked .env
# file or export it in your terminal. Current official models (2026-08):
# deepseek-v4-flash and deepseek-v4-pro.
DEEPSEEK_API_KEY=
TARCSMEM_DEEPSEEK_BASE_URL=https://api.deepseek.com
TARCSMEM_DEEPSEEK_MODEL=deepseek-v4-flash
TARCSMEM_DEEPSEEK_THINKING=false
TARCSMEM_DEEPSEEK_TIMEOUT=90
TARCSMEM_DEEPSEEK_MAX_RETRIES=2
TARCSMEM_DEEPSEEK_MAX_TOKENS=1024
# Optional private/corporate CA bundle. TLS verification is never disabled.
TARCSMEM_CA_BUNDLE=
# Cloud egress is fail-closed for confidential/restricted records. Changing this
# is a security-owner decision, not an application-user preference.
TARCSMEM_CLOUD_ALLOWED_CLASSIFICATIONS=public,internal
# Every generated answer must cite a source label from the governed evidence pack.
TARCSMEM_REQUIRE_GENERATION_CITATIONS=true

# Use local://./data/qdrant without Docker; change to http://127.0.0.1:6333 for a Qdrant server.
TARCSMEM_QDRANT_URL=local://./data/qdrant
TARCSMEM_RETRIEVAL_LIMIT=14
# Oversample before ACL/status/time filtering to avoid false abstention.
TARCSMEM_CANDIDATE_POOL_MULTIPLIER=5
TARCSMEM_EMBEDDING_BACKEND=hash
TARCSMEM_BGE_MODEL=BAAI/bge-small-zh-v1.5
TARCSMEM_RERANKER=off
TARCSMEM_RERANKER_MODEL=BAAI/bge-reranker-base
TARCSMEM_SEED_DEMO=true

# Optional Confluence Cloud REST API v2 incremental connector. Keep the API
# token only in .env/secret manager; the checkpoint stores versions and hashes,
# never credentials or page bodies.
TARCSMEM_CONFLUENCE_BASE_URL=
TARCSMEM_CONFLUENCE_EMAIL=
TARCSMEM_CONFLUENCE_API_TOKEN=
TARCSMEM_CONFLUENCE_SPACE_ID=
